# ==========================================
# Dependências e Módulos do Node.js
# ==========================================
**/node_modules/
**/package-lock.json
**/yarn.lock
**/pnpm-lock.yaml

# ==========================================
# Segurança e Variáveis de Ambiente (CRUCIAL)
# ==========================================
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
**/.env
**/.env.*
# Permite commitar apenas o template de exemplo se existir
!**/env.example
!**/.env.example

# ==========================================
# Docker, Sistema de Arquivos e Logs
# ==========================================
**/*.log
**/logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.DS_Store
Thumbs.db

# ==========================================
# IDEs e Editores de Código
# ==========================================
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp

# ==========================================
# Testes e Cobertura de Código
# ==========================================
**/coverage/
**/.nyc_output/
**/.jest/

# ==========================================
# Compilação e Pastas de Build (se houver)
# ==========================================
**/dist/
**/build/
